# News Backend API — environment variables template
#
# Copy this file to .env and fill in real values, or set these same keys
# as environment variables / .NET user secrets. NEVER commit real values.
#
# Key note: dotted section names (Jwt:Secret) become double-underscore
# environment variables (Jwt__Secret).

# --- Database -----------------------------------------------------------------
# SQL Server connection string. Replace server + database with your instance.
ConnectionStrings__DefaultConnection=Server=localhost;Database=NewsDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# --- JWT ----------------------------------------------------------------------
# HS256 signing key. MUST be at least 32 characters and kept secret.
Jwt__Secret=change-me-to-a-random-string-of-32-or-more-characters
Jwt__Issuer=NewsBackend
Jwt__Audience=NewsBackendClient
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

# --- Cloudinary (optional; required only for profile-photo upload) ------------
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=profile-images

# --- CORS ---------------------------------------------------------------------
# Either a single origin, a semi-colon/comma separated list, or * for any origin.
Cors__AllowedOrigins=*